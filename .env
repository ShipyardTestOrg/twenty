# Twenty server self URL (host-facing). The create-twenty-app tooling and every
# .env.example in this repo expect the server at http://localhost:2020.
# Override this with the assigned domain on the deploy target.
SERVER_URL=http://localhost:2020

# Connection strings for the bundled Postgres and Redis services.
PG_DATABASE_URL=postgres://postgres:postgres@postgres:5432/app
REDIS_URL=redis://redis:6379

# APP_SECRET is a required signing secret. Do NOT commit a value here:
# supply it via the Shipyard dashboard (locally the fix loop generates one).
# APP_SECRET=
